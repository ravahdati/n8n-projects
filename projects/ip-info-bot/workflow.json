{
  "name": "IP Info Bot",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json.output || $input.first().json.text || '';\nconst ip = aiResponse.trim();\n\nreturn {\n  json: {\n    ip: ip,\n    chatId: $('Telegram Trigger').item.json.message.chat.id\n  }\n};"
      },
      "id": "6addb0b9-4f56-4468-8c59-e86e03ee4f1f",
      "name": "Extract IP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "url": "=http://ip-api.com/json/{{ $json.ip }}?fields=status,message,country,regionName,city,zip,lat,lon,isp,org,query",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "9d98ef08-ae8a-4309-9781-a2d48486565b",
      "name": "Get IP Info (ip-api.com)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1024,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const ip = $('Extract IP').first().json.ip;\nconst chatId = $('Extract IP').first().json.chatId;\nconst data = $('Get IP Info (ip-api.com)').item.json;\n\ntry {\n  if (data && data.status === 'success') {\n    const lines = [];\n    lines.push(`🖧 IP: ${data.query}`);\n    lines.push(`🌍 کشور: ${data.country || '-'} ` + (data.regionName ? `(${data.regionName})` : ''));\n    lines.push(`🏙️ شهر: ${data.city || '-'} ${data.zip ? ' / ' + data.zip : ''}`);\n    lines.push(`📍 مختصات: ${data.lat || '-'}, ${data.lon || '-'} `);\n    lines.push(`🏢 ISP: ${data.isp || '-'} ` + (data.org ? ` / ${data.org}` : ''));\n\n    const message = lines.join('\\n');\n\n    return {\n      json: {\n        chatId: chatId,\n        message: message\n      }\n    };\n  } else if (data && data.status === 'fail') {\n    return {\n      json: {\n        chatId: chatId,\n        message: `❌ نتایج برای IP ${ip} یافت نشد: ${data.message || 'Unknown error'}`\n      }\n    };\n  }\n} catch (err) {\n  return {\n    json: {\n      chatId: chatId,\n      message: `❌ خطا در پردازش اطلاعات IP ${ip}`\n    }\n  };\n}\n\nreturn {\n  json: {\n    chatId: chatId,\n    message: `❌ خطا در دریافت اطلاعات برای IP ${ip}`\n  }\n};"
      },
      "id": "f48f8479-5b45-4b9b-b3f0-af6be5d925f0",
      "name": "Format IP Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        0
      ]
    },
