    {
      "parameters": {
        "jsCode": "// n8n Code node: Run Once for All Items. Same source is exercised by tests.\nconst input = $input.first().json;\nconst p = input.body || {};\nconst clean = (v, max) => String(v ?? '').replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]/g, '').trim().slice(0,max);\nconst digits = v => v.replace(/[۰-۹]/g,c=>String('۰۱۲۳۴۵۶۷۸۹'.indexOf(c))).replace(/[٠-٩]/g,c=>String('٠١٢٣٤٥٦٧٨٩'.indexOf(c)));\nconst email=clean(p.email,254).toLowerCase();\nlet phone=digits(clean(p.phone,40)).replace(/[\\s().-]/g,'');\nif (/^0098\\d{10}$/.test(phone)) phone='+'+phone.slice(2);\nif (/^09\\d{9}$/.test(phone)) phone='+98'+phone.slice(1);\nconst errors=[];\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Invalid email');\nif (phone && !/^\\+?[0-9]{7,15}$/.test(phone)) errors.push('Invalid phone');\nif (!email && !phone) errors.push('Email or phone is required');\nconst event_id=clean(p.event_id,220);\nif (!/^[a-zA-Z0-9:._-]{3,220}$/.test(event_id)) errors.push('Invalid event_id');\nlet source_url=clean(p.source_url,1000);\nif (source_url && !/^https?:\\/\\/[^\\s]+$/i.test(source_url)) errors.push('Invalid source_url');\nif (errors.length) return [{json:{valid:false,ok:false,errors}}];\nreturn [{json:{valid:true,event_id,contact_key:email?'email:'+email:'phone:'+phone,\n name:clean(p.name,200),email,phone,message:clean(p.message,5000),source_url,\n form_id:clean(p.form_id,30),entry_id:clean(p.entry_id,30),\n received_at:new Date().toISOString()}}];\n"
      },
