    {
      "parameters": {
        "jsCode": "// Add or remove sites here\nconst sites = [\n  'https://n8n.io',\n  'https://google.com',\n];\nreturn sites.map(url => ({ json: { url } }));\n"
      },
      "id": "e8ee3de1-9613-4fbf-a165-9e5934fad697",
      "name": "Sites list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        416
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "body"
            }
          },
          "timeout": 15000
        }
      },
      "id": "1901d0b0-eb0d-4c99-866a-555bfd552de1",
      "name": "Check site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        416
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const sites = $('Sites list').all();\nconst checks = $input.all();\nconst lines = sites.map((s, i) => {\n  const code = Number(checks[i] && checks[i].json.statusCode) || 0;\n  const up = code >= 200 && code < 400;\n  return (up ? '✅ UP' : '❌ DOWN') + ' ' + s.json.url + ' (' + (code ? 'HTTP ' + code : 'No response') + ')';\n});\nconst text = 'Website check report\\n\\n' + lines.join('\\n');\nreturn [{ json: { text } }];\n"
      },
      "id": "edb137c5-c9f5-4f55-8551-bee4c9f157e8",
