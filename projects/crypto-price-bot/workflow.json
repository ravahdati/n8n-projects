{
  "name": "Crypto Price Bot",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json.output;\nconst symbol = aiResponse.trim().toUpperCase();\n\nreturn {\n  json: {\n    symbol: symbol,\n    chatId: $('Telegram Trigger').item.json.message.chat.id\n  }\n};"
      },
      "id": "f93a4303-cd97-46f4-b3ea-859de4bd606e",
      "name": "Extract Symbol",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.binance.com/api/v3/ticker/price?symbol={{ $json.symbol }}USDT",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e71f9d08-f82e-45bd-ae90-6d97796bdee1",
      "name": "Get Price - Binance (Backup)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1024,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const symbol = $('Extract Symbol').first().json.symbol;\nconst chatId = $('Extract Symbol').first().json.chatId;\n\ntry {\n    const binanceData = $('Get Price - Binance (Backup)').item.json;\n    if (binanceData.price) {\n      const price = parseFloat(binanceData.price).toFixed(2);\n      const message = `💰 نماد: ${symbol.toUpperCase()}/USDT\\n` +\n                     `💵 قیمت: ${parseFloat(price).toLocaleString()} دلار\\n` +\n                     `📊 منبع: Binance`;\n      \n      return {\n        json: {\n          chatId: chatId,\n          message: message\n        }\n      };\n    }\n  } catch (binanceError) {\n    return {\n      json: {\n        chatId: chatId,\n        message: `❌ متأسفانه نتوانستم قیمت ${symbol} را پیدا کنم. لطفاً از نام صحیح رمز ارز استفاده کنید.`\n      }\n    };\n  }\n\nreturn {\n  json: {\n    chatId: chatId,\n    message: `❌ خطا در دریافت قیمت ${symbol}`\n  }\n};"
      },
      "id": "778066b6-f1ee-4054-91d7-6dc3ecea98aa",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
